# Yandex Cloud API Configuration
YANDEX_API_KEY=your_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here

# ClickHouse Configuration
# Note: Include protocol (https://) for secure connections to cloud services
# For local servers, you can omit the protocol (defaults to http://)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=metrika_hits

# Optional: Request timeout in seconds (default: 30)
CLICKHOUSE_TIMEOUT=30

# Logging Configuration (optional)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
